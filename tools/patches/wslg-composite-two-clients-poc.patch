+#define MANIFOLD_COMPOSITE_COLUMNS 2
+#define MANIFOLD_COMPOSITE_CELL_WIDTH 640
+#define MANIFOLD_COMPOSITE_CELL_HEIGHT 480
+#define MANIFOLD_COMPOSITE_MARGIN 0
+#define MANIFOLD_COMPOSITE_GAP 0
+#define MANIFOLD_COMPOSITE_WIDTH \
+	((MANIFOLD_COMPOSITE_MARGIN * 2) + \
+	 (MANIFOLD_COMPOSITE_CELL_WIDTH * MANIFOLD_COMPOSITE_COLUMNS) + \
+	 (MANIFOLD_COMPOSITE_GAP * (MANIFOLD_COMPOSITE_COLUMNS - 1)))
+#define MANIFOLD_COMPOSITE_HEIGHT \
+	((MANIFOLD_COMPOSITE_MARGIN * 2) + MANIFOLD_COMPOSITE_CELL_HEIGHT)
+#define MANIFOLD_COMPOSITE_MAX_SURFACES 2
+
+static bool
+rdp_rail_manifold_composite_enabled(void)
+{
+	const char *value = getenv("MANIFOLD_WSLG_COMPOSITE");
+
+	return !value || strcmp(value, "0") != 0;
+}
+
+static bool
+rdp_rail_manifold_composite_candidate(struct rdp_backend *b,
+				      struct weston_surface *surface)
+{
+	if (!rdp_rail_manifold_composite_enabled())
+		return false;
+	if (!surface || surface == b->proxy_surface)
+		return false;
+	if (surface->width <= 0 || surface->height <= 0)
+		return false;
+	if (surface->role_name) {
+		if (strcmp(surface->role_name, "wl_subsurface") == 0 ||
+		    strcmp(surface->role_name, "wl_pointer-cursor") == 0)
+			return false;
+	}
+	if (wl_list_empty(&surface->views))
+		return false;
+
+	return true;
+}
+
+static void
+rdp_rail_manifold_damage_composite_host(struct rdp_backend *b)
+{
+	struct weston_surface *host = b->manifold_composite_host_surface;
+	struct weston_surface_rail_state *host_state;
+
+	if (!host)
+		return;
+
+	host_state = host->backend_state;
+	if (!host_state)
+		return;
+
+	pixman_region32_union_rect(&host_state->damage, &host_state->damage,
+				   0, 0,
+				   MANIFOLD_COMPOSITE_WIDTH,
+				   MANIFOLD_COMPOSITE_HEIGHT);
+	weston_compositor_damage_all(b->compositor);
+}
+
+static void
+rdp_rail_manifold_choose_composite_host(struct rdp_backend *b,
+					struct weston_surface *surface)
+{
+	if (b->manifold_composite_host_surface)
+		return;
+	if (!rdp_rail_manifold_composite_candidate(b, surface))
+		return;
+
+	b->manifold_composite_host_surface = surface;
+	rdp_debug(b, "Manifold composite host surface: %p\n", surface);
+}
+
+static void
+rdp_rail_manifold_composite_slot_rect(int slot,
+				      int *x,
+				      int *y,
+				      int *width,
+				      int *height)
+{
+	*x = MANIFOLD_COMPOSITE_MARGIN +
+	     slot * (MANIFOLD_COMPOSITE_CELL_WIDTH + MANIFOLD_COMPOSITE_GAP);
+	*y = MANIFOLD_COMPOSITE_MARGIN;
+	*width = MANIFOLD_COMPOSITE_CELL_WIDTH;
+	*height = MANIFOLD_COMPOSITE_CELL_HEIGHT;
+}
+
+static void
+rdp_rail_manifold_get_copy_geometry(struct rdp_backend *b,
+				    struct weston_surface *surface,
+				    struct weston_geometry *geometry);
+
+static void
+rdp_rail_manifold_layout_surface(struct rdp_backend *b,
+				 struct weston_surface *surface,
+				 int slot)
+{
+	struct weston_surface_rail_state *rail_state = surface->backend_state;
+	struct weston_geometry geometry;
+	int x, y, width, height;
+	int request_x, request_y, request_width, request_height;
+	int frame_width, frame_height;
+
+	if (!rail_state || !b->rdprail_shell_api ||
+	    !b->rdprail_shell_api->request_window_move)
+		return;
+
+	rdp_rail_manifold_composite_slot_rect(slot, &x, &y, &width, &height);
+	rdp_rail_manifold_get_copy_geometry(b, surface, &geometry);
+	frame_width = max(0, surface->width - geometry.width);
+	frame_height = max(0, surface->height - geometry.height);
+	request_x = x - geometry.x;
+	request_y = y - geometry.y;
+	request_width = width + frame_width;
+	request_height = height + frame_height;
+
+	if (rail_state->manifoldCompositeLayoutValid &&
+	    rail_state->manifoldCompositeLayoutX == x &&
+	    rail_state->manifoldCompositeLayoutY == y &&
+	    rail_state->manifoldCompositeLayoutWidth == width &&
+	    rail_state->manifoldCompositeLayoutHeight == height)
+		return;
+
+	b->rdprail_shell_api->request_window_move(surface,
+						 request_x, request_y,
+						 request_width, request_height);
+	rail_state->manifoldCompositeLayoutValid = true;
+	rail_state->manifoldCompositeLayoutX = x;
+	rail_state->manifoldCompositeLayoutY = y;
+	rail_state->manifoldCompositeLayoutWidth = width;
+	rail_state->manifoldCompositeLayoutHeight = height;
+	rdp_debug(b,
+		  "Manifold composite layout surface:%p slot:%d content:(%d,%d) %dx%d request:(%d,%d) %dx%d frame:%dx%d\n",
+		  surface, slot, x, y, width, height,
+		  request_x, request_y, request_width, request_height,
+		  frame_width, frame_height);
+}
+
+static void
+rdp_rail_manifold_get_copy_geometry(struct rdp_backend *b,
+				    struct weston_surface *surface,
+				    struct weston_geometry *geometry)
+{
+	geometry->x = 0;
+	geometry->y = 0;
+	geometry->width = surface->width;
+	geometry->height = surface->height;
+
+	if (b->rdprail_shell_api && b->rdprail_shell_api->get_window_geometry)
+		b->rdprail_shell_api->get_window_geometry(surface, geometry);
+
+	if (geometry->x < 0)
+		geometry->x = 0;
+	if (geometry->y < 0)
+		geometry->y = 0;
+	if (geometry->width < 0)
+		geometry->width = 0;
+	if (geometry->height < 0)
+		geometry->height = 0;
+	if (geometry->x + geometry->width > surface->width)
+		geometry->width = surface->width - geometry->x;
+	if (geometry->y + geometry->height > surface->height)
+		geometry->height = surface->height - geometry->y;
+	if (geometry->width < 0)
+		geometry->width = 0;
+	if (geometry->height < 0)
+		geometry->height = 0;
+}
+
+struct manifold_composite_copy_data {
+	struct rdp_backend *b;
+	struct weston_surface *host;
+	BYTE *bits;
+	int buffer_size;
+	int stride;
+	int slot;
+};
+
+static int
+rdp_rail_copy_manifold_surface(struct manifold_composite_copy_data *data,
+			       struct weston_surface *surface)
+{
+	struct weston_geometry geometry;
+	int slot_x, slot_y, slot_width, slot_height;
+	int content_width, content_height;
+	int src_x, src_y;
+	int width, height;
+	int x, y, offset;
+	size_t required;
+
+	if (data->slot >= MANIFOLD_COMPOSITE_MAX_SURFACES)
+		return 0;
+
+	rdp_rail_manifold_layout_surface(data->b, surface, data->slot);
+	rdp_rail_manifold_get_copy_geometry(data->b, surface, &geometry);
+
+	rdp_rail_manifold_composite_slot_rect(data->slot,
+					      &slot_x, &slot_y,
+					      &slot_width, &slot_height);
+	width = min(geometry.width, slot_width);
+	height = min(geometry.height, slot_height);
+	if (width <= 0 || height <= 0)
+		return 0;
+
+	weston_surface_get_content_size(surface, &content_width, &content_height);
+	if (content_width <= 0 || content_height <= 0)
+		return 0;
+
+	src_x = geometry.x;
+	src_y = geometry.y;
+	if (src_x + width > content_width) {
+		if (width <= content_width)
+			src_x = 0;
+		else if (src_x < content_width)
+			width = content_width - src_x;
+		else
+			return 0;
+	}
+	if (src_y + height > content_height) {
+		if (height <= content_height)
+			src_y = 0;
+		else if (src_y < content_height)
+			height = content_height - src_y;
+		else
+			return 0;
+	}
+	if (width <= 0 || height <= 0)
+		return 0;
+
+	x = slot_x + (slot_width - width) / 2;
+	y = slot_y + (slot_height - height) / 2;
+	offset = y * data->stride + x * 4;
+	required = (size_t)offset +
+		   (size_t)(height - 1) * (size_t)data->stride +
+		   (size_t)width * 4;
+	if (offset < 0 || required > (size_t)data->buffer_size) {
+		rdp_debug_error(data->b,
+				"Manifold composite copy out of bounds for surface:%p slot:%d dst:(%d,%d) %dx%d required:%zu buffer:%d\n",
+				surface, data->slot, x, y, width, height,
+				required, data->buffer_size);
+		return -1;
+	}
+
+	if (weston_surface_copy_content(surface,
+					data->bits + offset,
+					data->buffer_size,
+					data->stride,
+					width,
+					height,
+					src_x,
+					src_y,
+					width,
+					height,
+					false,
+					true) < 0) {
+		rdp_debug_error(data->b,
+				"Manifold composite copy failed for surface:%p slot:%d src:(%d,%d) %dx%d content:%dx%d geometry:(%d,%d) %dx%d dst:(%d,%d)\n",
+				surface, data->slot,
+				src_x, src_y, width, height,
+				content_width, content_height,
+				geometry.x, geometry.y,
+				geometry.width, geometry.height,
+				x, y);
+		return -1;
+	}
+
+	data->slot++;
+	return 0;
+}
+
+static void
+rdp_rail_copy_manifold_surface_iter(void *element, void *opaque)
+{
+	struct weston_view *view = element;
+	struct weston_surface *surface = view->surface;
+	struct manifold_composite_copy_data *data = opaque;
+
+	if (surface == data->host)
+		return;
+	if (!rdp_rail_manifold_composite_candidate(data->b, surface))
+		return;
+	if (data->slot >= MANIFOLD_COMPOSITE_MAX_SURFACES)
+		return;
+
+	rdp_rail_copy_manifold_surface(data, surface);
+}
+
+static int
+rdp_rail_copy_manifold_composite(struct rdp_backend *b,
+				 struct weston_surface *host,
+				 BYTE *bits,
+				 int buffer_size,
+				 int stride)
+{
+	struct manifold_composite_copy_data data = {
+		.b = b,
+		.host = host,
+		.bits = bits,
+		.buffer_size = buffer_size,
+		.stride = stride,
+		.slot = 0,
+	};
+	struct weston_view *view;
+	uint32_t *pixels = (uint32_t *)bits;
+	int pixel_count = (stride / 4) * MANIFOLD_COMPOSITE_HEIGHT;
+
+	for (int i = 0; i < pixel_count; i++)
+		pixels[i] = 0xff101820;
+
+	if (rdp_rail_copy_manifold_surface(&data, host) < 0)
+		return -1;
+
+	wl_list_for_each_reverse(view, &b->compositor->view_list, link) {
+		rdp_rail_copy_manifold_surface_iter(view, &data);
+		if (data.slot >= MANIFOLD_COMPOSITE_MAX_SURFACES)
+			break;
+	}
+
+	return 0;
+}
