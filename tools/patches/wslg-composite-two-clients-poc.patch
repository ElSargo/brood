+#define MANIFOLD_COMPOSITE_COLUMNS 2
+#define MANIFOLD_COMPOSITE_CELL_WIDTH 640
+#define MANIFOLD_COMPOSITE_CELL_HEIGHT 480
+#define MANIFOLD_COMPOSITE_MARGIN 24
+#define MANIFOLD_COMPOSITE_GAP 24
+#define MANIFOLD_COMPOSITE_WIDTH \
+	((MANIFOLD_COMPOSITE_MARGIN * 2) + \
+	 (MANIFOLD_COMPOSITE_CELL_WIDTH * MANIFOLD_COMPOSITE_COLUMNS) + \
+	 (MANIFOLD_COMPOSITE_GAP * (MANIFOLD_COMPOSITE_COLUMNS - 1)))
+#define MANIFOLD_COMPOSITE_HEIGHT \
+	((MANIFOLD_COMPOSITE_MARGIN * 2) + MANIFOLD_COMPOSITE_CELL_HEIGHT)
+#define MANIFOLD_COMPOSITE_MAX_SURFACES 2
+
+static bool
+rdp_rail_manifold_composite_enabled(void)
+{
+	const char *value = getenv("MANIFOLD_WSLG_COMPOSITE");
+
+	return !value || strcmp(value, "0") != 0;
+}
+
+static bool
+rdp_rail_manifold_composite_candidate(struct rdp_backend *b,
+				      struct weston_surface *surface)
+{
+	if (!rdp_rail_manifold_composite_enabled())
+		return false;
+	if (!surface || surface == b->proxy_surface)
+		return false;
+	if (surface->width <= 0 || surface->height <= 0)
+		return false;
+	if (surface->role_name) {
+		if (strcmp(surface->role_name, "wl_subsurface") == 0 ||
+		    strcmp(surface->role_name, "wl_pointer-cursor") == 0)
+			return false;
+	}
+	if (wl_list_empty(&surface->views))
+		return false;
+
+	return true;
+}
+
+static void
+rdp_rail_manifold_damage_composite_host(struct rdp_backend *b)
+{
+	struct weston_surface *host = b->manifold_composite_host_surface;
+	struct weston_surface_rail_state *host_state;
+
+	if (!host)
+		return;
+
+	host_state = host->backend_state;
+	if (!host_state)
+		return;
+
+	pixman_region32_union_rect(&host_state->damage, &host_state->damage,
+				   0, 0,
+				   MANIFOLD_COMPOSITE_WIDTH,
+				   MANIFOLD_COMPOSITE_HEIGHT);
+	weston_compositor_damage_all(b->compositor);
+}
+
+static void
+rdp_rail_manifold_choose_composite_host(struct rdp_backend *b,
+					struct weston_surface *surface)
+{
+	if (b->manifold_composite_host_surface)
+		return;
+	if (!rdp_rail_manifold_composite_candidate(b, surface))
+		return;
+
+	b->manifold_composite_host_surface = surface;
+	rdp_debug(b, "Manifold composite host surface: %p\n", surface);
+}
+
+struct manifold_composite_copy_data {
+	struct rdp_backend *b;
+	struct weston_surface *host;
+	BYTE *bits;
+	int buffer_size;
+	int stride;
+	int slot;
+};
+
+static int
+rdp_rail_copy_manifold_surface(struct manifold_composite_copy_data *data,
+			       struct weston_surface *surface)
+{
+	int width = min(surface->width, MANIFOLD_COMPOSITE_CELL_WIDTH);
+	int height = min(surface->height, MANIFOLD_COMPOSITE_CELL_HEIGHT);
+	int x, y, offset;
+
+	if (data->slot >= MANIFOLD_COMPOSITE_MAX_SURFACES)
+		return 0;
+	if (width <= 0 || height <= 0)
+		return 0;
+
+	x = MANIFOLD_COMPOSITE_MARGIN +
+	    data->slot * (MANIFOLD_COMPOSITE_CELL_WIDTH + MANIFOLD_COMPOSITE_GAP);
+	y = MANIFOLD_COMPOSITE_MARGIN +
+	    (MANIFOLD_COMPOSITE_CELL_HEIGHT - height) / 2;
+	offset = y * data->stride + x * 4;
+
+	if (weston_surface_copy_content(surface,
+					data->bits + offset,
+					data->buffer_size - offset,
+					data->stride,
+					width,
+					height,
+					0,
+					0,
+					width,
+					height,
+					false,
+					true) < 0) {
+		rdp_debug_error(data->b,
+				"Manifold composite copy failed for surface:%p slot:%d\n",
+				surface, data->slot);
+		return -1;
+	}
+
+	data->slot++;
+	return 0;
+}
+
+static void
+rdp_rail_copy_manifold_surface_iter(void *element, void *opaque)
+{
+	struct weston_view *view = element;
+	struct weston_surface *surface = view->surface;
+	struct manifold_composite_copy_data *data = opaque;
+
+	if (surface == data->host)
+		return;
+	if (!rdp_rail_manifold_composite_candidate(data->b, surface))
+		return;
+	if (data->slot >= MANIFOLD_COMPOSITE_MAX_SURFACES)
+		return;
+
+	rdp_rail_copy_manifold_surface(data, surface);
+}
+
+static int
+rdp_rail_copy_manifold_composite(struct rdp_backend *b,
+				 struct weston_surface *host,
+				 BYTE *bits,
+				 int buffer_size,
+				 int stride)
+{
+	struct manifold_composite_copy_data data = {
+		.b = b,
+		.host = host,
+		.bits = bits,
+		.buffer_size = buffer_size,
+		.stride = stride,
+		.slot = 0,
+	};
+	struct weston_view *view;
+	uint32_t *pixels = (uint32_t *)bits;
+	int pixel_count = (stride / 4) * MANIFOLD_COMPOSITE_HEIGHT;
+
+	for (int i = 0; i < pixel_count; i++)
+		pixels[i] = 0xff101820;
+
+	if (rdp_rail_copy_manifold_surface(&data, host) < 0)
+		return -1;
+
+	wl_list_for_each_reverse(view, &b->compositor->view_list, link) {
+		rdp_rail_copy_manifold_surface_iter(view, &data);
+		if (data.slot >= MANIFOLD_COMPOSITE_MAX_SURFACES)
+			break;
+	}
+
+	return 0;
+}
