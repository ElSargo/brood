(typename $errno
  (enum (@witx tag u32)
    $success
    $invalid
    $unavailable
    $limit
  )
)
(typename $word u32)
(typename $identifier u64)

(module $brood_preview1
  (import "memory" (memory))

  (@interface func (export "event_kind")
    (result $result (expected $word (error $errno)))
  )
  (@interface func (export "event_sender_len")
    (result $result (expected $word (error $errno)))
  )
  (@interface func (export "event_payload_len")
    (result $result (expected $word (error $errno)))
  )
  (@interface func (export "event_operation")
    (result $result (expected $identifier (error $errno)))
  )
  (@interface func (export "event_value")
    (result $result (expected $identifier (error $errno)))
  )
  (@interface func (export "event_token")
    (result $result (expected $identifier (error $errno)))
  )
  (@interface func (export "event_read")
    (param $sender (@witx pointer u8))
    (param $sender_len u32)
    (param $payload (@witx pointer u8))
    (param $payload_len u32)
    (result $result (expected (error $errno)))
  )
  ;; Lifecycle events have dedicated kinds. `event_operation` is generation,
  ;; `event_value` is the typed reason tag, `event_token` is session/next
  ;; generation (zero means absent), sender is instance id, and payload is the
  ;; guest capability root. Start data uses indexed structured entries below.
  (@interface func (export "event_lifecycle_data_count")
    (result $result (expected $word (error $errno)))
  )
  (@interface func (export "event_lifecycle_key_len")
    (param $index u32)
    (result $result (expected $word (error $errno)))
  )
  (@interface func (export "event_lifecycle_value_len")
    (param $index u32)
    (result $result (expected $word (error $errno)))
  )
  (@interface func (export "event_lifecycle_data_read")
    (param $index u32)
    (param $key (@witx pointer u8))
    (param $key_len u32)
    (param $value (@witx pointer u8))
    (param $value_len u32)
    (result $result (expected (error $errno)))
  )
  (@interface func (export "lifecycle_complete")
    (param $status u32)
    (param $message (@witx pointer u8))
    (param $message_len u32)
    (result $result (expected (error $errno)))
  )

  (@interface func (export "completion_submit_read")
    (param $path (@witx pointer u8))
    (param $path_len u32)
    (param $offset u64)
    (param $max_bytes u32)
    (result $result (expected $identifier (error $errno)))
  )
  (@interface func (export "completion_submit_write")
    (param $path (@witx pointer u8))
    (param $path_len u32)
    (param $offset u64)
    (param $bytes (@witx pointer u8))
    (param $bytes_len u32)
    (result $result (expected $identifier (error $errno)))
  )
  ;; A nonzero word means the cancellation request was admitted. If it wins
  ;; the race with result delivery, a terminal cancellation event arrives later.
  (@interface func (export "completion_cancel")
    (param $operation u64)
    (result $result (expected $word (error $errno)))
  )

  ;; Generation-owned runtime I/O. Arguments are NUL-separated UTF-8 strings;
  ;; readiness always uses the ordinary notification/pollable functions below.
  (@interface func (export "subprocess_spawn")
    (param $command (@witx pointer u8)) (param $command_len u32)
    (param $arguments (@witx pointer u8)) (param $arguments_len u32)
    (result $result (expected $identifier (error $errno)))
  )
  (@interface func (export "pty_spawn")
    (param $command (@witx pointer u8)) (param $command_len u32)
    (param $arguments (@witx pointer u8)) (param $arguments_len u32)
    (param $rows u32) (param $cols u32)
    ;; zero selects the deterministic xterm-256color/truecolor profile.
    (param $terminal_profile u32)
    (result $result (expected $identifier (error $errno)))
  )
  (@interface func (export "pty_resize")
    (param $child u64) (param $rows u32) (param $cols u32)
    (result $result (expected (error $errno)))
  )
  (@interface func (export "worker_loopback_connect")
    (param $address (@witx pointer u8)) (param $address_len u32)
    (result $result (expected $identifier (error $errno)))
  )
  ;; kind 0/1/2 select stdin/stdout/stderr pipes; kind 3 selects the PTY.
  (@interface func (export "child_stream")
    (param $child u64) (param $kind u32)
    (result $result (expected $identifier (error $errno)))
  )
  (@interface func (export "child_notification")
    (param $child u64) (result $result (expected $identifier (error $errno)))
  )
  ;; 0 running, 1 exited with a code available below, 2 signalled.
  (@interface func (export "child_status")
    (param $child u64) (result $result (expected $word (error $errno)))
  )
  (@interface func (export "child_exit_code")
    (param $child u64) (result $result (expected $word (error $errno)))
  )
  (@interface func (export "child_resolved_command_len")
    (param $child u64) (result $result (expected $word (error $errno)))
  )
  (@interface func (export "child_resolved_command_read")
    (param $child u64) (param $path (@witx pointer u8)) (param $path_len u32)
    (result $result (expected (error $errno)))
  )
  (@interface func (export "child_drop")
    (param $child u64) (result $result (expected (error $errno)))
  )
  (@interface func (export "stream_notification")
    (param $stream u64) (result $result (expected $identifier (error $errno)))
  )
  (@interface func (export "stream_read")
    (param $stream u64) (param $bytes (@witx pointer u8)) (param $bytes_len u32)
    ;; bytes read; u64::MAX is EOF, u64::MAX-1 is would-block.
    (result $result (expected $identifier (error $errno)))
  )
  (@interface func (export "stream_write")
    (param $stream u64) (param $bytes (@witx pointer u8)) (param $bytes_len u32)
    (result $result (expected $word (error $errno)))
  )
  (@interface func (export "stream_close_write")
    (param $stream u64) (result $result (expected (error $errno)))
  )
  (@interface func (export "stream_drop")
    (param $stream u64) (result $result (expected (error $errno)))
  )
  (@interface func (export "timer_create")
    (param $delay_ms u64) (result $result (expected $identifier (error $errno)))
  )
  (@interface func (export "timer_notification")
    (param $timer u64) (result $result (expected $identifier (error $errno)))
  )
  ;; zero pending, one expired.
  (@interface func (export "timer_status")
    (param $timer u64) (result $result (expected $word (error $errno)))
  )
  (@interface func (export "timer_drop")
    (param $timer u64) (result $result (expected (error $errno)))
  )

  ;; Watches are rooted in the actor's filesystem capability. The watch owns
  ;; one notification which workers can project into the normal pollable set.
  ;; Event batches are UTF-8 lines: kind, tab, capability-relative path. Path
  ;; bytes outside printable ASCII, plus literal `%`, use uppercase `%HH`
  ;; escapes, so native names and line delimiters remain reversible.
  (@interface func (export "filesystem_watch_create")
    (param $path (@witx pointer u8))
    (param $path_len u32)
    (param $recursive u32)
    (result $result (expected $identifier (error $errno)))
  )
  (@interface func (export "filesystem_watch_notification")
    (param $watch u64)
    (result $result (expected $identifier (error $errno)))
  )
  (@interface func (export "filesystem_watch_event_bytes")
    (param $watch u64)
    (result $result (expected $word (error $errno)))
  )
  (@interface func (export "filesystem_watch_read")
    (param $watch u64)
    (param $events (@witx pointer u8))
    (param $events_len u32)
    (result $result (expected $identifier (error $errno)))
  )
  (@interface func (export "filesystem_watch_drop")
    (param $watch u64)
    (result $result (expected (error $errno)))
  )

  (@interface func (export "worker_spawn")
    (param $argument u32)
    (result $result (expected $identifier (error $errno)))
  )
  ;; Optional compatibility adapter. Normal workers receive closed stdin and
  ;; coordinate through shared memory plus notifications.
  (@interface func (export "worker_spawn_with_stdin")
    (param $argument u32)
    (result $result (expected $identifier (error $errno)))
  )
  ;; A nonzero word means the worker was current and the request was admitted;
  ;; terminal worker-cancelled delivery happens asynchronously.
  (@interface func (export "worker_cancel")
    (param $worker u64)
    (result $result (expected $word (error $errno)))
  )
  (@interface func (export "worker_input")
    (param $worker u64)
    (param $bytes (@witx pointer u8))
    (param $bytes_len u32)
    (result $result (expected (error $errno)))
  )

  ;; Notifications carry only scheduling state. Payloads, queue indices, and
  ;; synchronization protocols remain guest-owned in shared linear memory.
  (@interface func (export "notification_create")
    (result $result (expected $identifier (error $errno)))
  )
  (@interface func (export "notification_drop")
    (param $notification u64)
    (result $result (expected (error $errno)))
  )
  (@interface func (export "notification_signal")
    (param $notification u64)
    (param $generation u64)
    (result $result (expected $identifier (error $errno)))
  )
  ;; Zero means armed. One means readiness was already known and the event was
  ;; queued. Actor watches are one-shot and must be re-armed after dispatch.
  (@interface func (export "notification_watch")
    (param $notification u64)
    (param $observed_generation u64)
    (param $token u64)
    (result $result (expected $word (error $errno)))
  )
  (@interface func (export "notification_unwatch")
    (param $notification u64)
    (result $result (expected $word (error $errno)))
  )

  ;; Pollables are worker scheduling handles, not guest synchronization data.
  (@interface func (export "notification_pollable")
    (param $notification u64)
    (param $observed_generation u64)
    (result $result (expected $identifier (error $errno)))
  )
  (@interface func (export "pollable_drop")
    (param $pollable u64)
    (result $result (expected (error $errno)))
  )
  ;; Return the latest generation when ready; unavailable means not ready.
  (@interface func (export "pollable_generation")
    (param $pollable u64)
    (result $result (expected $identifier (error $errno)))
  )
  ;; Suspend only the calling worker and return the ready pollable ID. Timeout
  ;; is relative milliseconds; u64::MAX means no deadline. Mode zero is biased
  ;; and one is rotating fair selection.
  (@interface func (export "worker_wait_any")
    (param $pollables (list u64))
    (param $timeout_ms u64)
    (param $mode u32)
    (result $result (expected $identifier (error $errno)))
  )
)
